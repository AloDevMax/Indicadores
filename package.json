{
  "name": "labquest-sistema-de-qualidade-gamificado",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --env-file=.env scripts/dbPush.mjs && node --env-file=.env server/index.mjs",
    "db:push": "node --env-file=.env scripts/dbPush.mjs",
    "db:check": "node --env-file=.env scripts/dbCheck.mjs",
    "db:reset:labvw": "node --env-file=.env scripts/resetLabvwFromXlsx.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/index.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "lucide-react": "^1.16.0",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.5.0",
    "xlsx": "0.18.5",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "typescript": "~5.8.2",
    "vite": "^6.4.1",
    "vitest": "^4.1.10"
  }
}
