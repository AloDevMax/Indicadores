# O Hostinger roda "npm install" com as variáveis do app já carregadas (NODE_ENV=production), o que faria o npm
# pular as devDependencies que o build precisa (prisma, vite, typescript).
include=dev
# eslint-plugin-react@7 declara peer eslint <=9 e o projeto usa eslint 10; sem isto o "npm install" falha com
# ERESOLVE ao re-resolver a árvore (o "npm ci" passa porque segue o lockfile).
legacy-peer-deps=true
