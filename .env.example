# Ambiente: development | test | production
NODE_ENV=development

# Servidor
PORT=4004
# Origens permitidas no CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000

# Banco de dados (OBRIGATÓRIA em produção)
DATABASE_URL=postgresql://labquest:labquest@localhost:5432/labquest?sslmode=disable
# SSL na conexão com o banco: só "false" desliga
DATABASE_SSL=false

# Variáveis do PostgreSQL (usadas pelo Docker Compose)
POSTGRES_USER=labquest
POSTGRES_PASSWORD=labquest
POSTGRES_DB=labquest

# Autenticação (OBRIGATÓRIA em produção)
AUTH_SECRET=troque-por-um-segredo-forte-em-producao

# Senha inicial da conta developer embutida (OBRIGATÓRIA em produção)
DEVELOPER_INITIAL_PASSWORD=troque-por-uma-senha-forte
